#import <Foundation/Foundation.h>
#import <mach-o/dyld.h>
#import <string.h>
#import <stdint.h>

#define TAG "[RBXFF] "

// FFlag injection by direct global write. No hooks.
//
// Every Roblox fast-variable has a dedicated storage slot in RobloxLib's
// __DATA (the "value" field of its registration entry) that the engine reads
// live. regmap.c (generated by static analysis of all registration sites)
// maps the bare flag name -> storage offset within RobloxLib. At runtime we
// find RobloxLib's load address and write the user's value straight into the
// slot. No Substrate, no gate, no CDN.

extern const unsigned RBX_NREG;
extern const char     RBX_NAMES[];
extern const unsigned RBX_NAMEOFF[];
extern const unsigned RBX_FLAGOFF[];

static NSString *docFile(NSString *n) {
    NSString *doc = [NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES) firstObject];
    return [doc stringByAppendingPathComponent:n];
}
// LiveContainer's own container Documents (shallow, visible in Files app) is
// everything up to and including the FIRST "/Documents" in the guest path.
// The guest's Documents is nested far deeper and hard to reach in Files.
static NSString *lcRootDoc(NSString *n) {
    NSString *guest = [NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES) firstObject];
    NSRange r = [guest rangeOfString:@"/Documents"];
    NSString *root = (r.location != NSNotFound)
        ? [guest substringToIndex:r.location + r.length] : guest;
    return [root stringByAppendingPathComponent:n];
}
static NSString *logPath(void)   { return docFile(@"rbxff_log.txt"); }
// Edit this file in Files app -> On My iPhone -> LiveContainer -> fflags.json
static NSString *flagsPath(void) { return lcRootDoc(@"fflags.json"); }

static void rbxlog(NSString *fmt, ...) {
    va_list ap; va_start(ap, fmt);
    NSString *line = [[NSString alloc] initWithFormat:fmt arguments:ap];
    va_end(ap);
    NSLog(@TAG "%@", line);
    NSString *p = logPath();
    NSFileHandle *fh = [NSFileHandle fileHandleForWritingAtPath:p];
    if (!fh) { [[NSString string] writeToFile:p atomically:YES encoding:NSUTF8StringEncoding error:nil];
               fh = [NSFileHandle fileHandleForWritingAtPath:p]; }
    [fh seekToEndOfFile];
    [fh writeData:[[line stringByAppendingString:@"\n"] dataUsingEncoding:NSUTF8StringEncoding]];
    [fh closeFile];
}

// Find RobloxLib Mach-O header address (= slide, since preferred vmaddr is 0).
static uintptr_t robloxLibBase(void) {
    uint32_t n = _dyld_image_count();
    for (uint32_t i = 0; i < n; i++) {
        const char *nm = _dyld_get_image_name(i);
        if (nm && strstr(nm, "RobloxLib"))
            return (uintptr_t)_dyld_get_image_header(i);
    }
    return 0;
}

// Roblox registers fast-vars under their bare name (type prefix stripped).
static const char *stripPrefix(const char *s) {
    static const char *pre[] = {
        "DFFlag","SFFlag","FFlag","DFInt","SFInt","FInt",
        "DFString","SFString","FString","DFLog","FLog","PFFlag","PFInt", NULL };
    for (int i = 0; pre[i]; i++) {
        size_t l = strlen(pre[i]);
        if (strncmp(s, pre[i], l) == 0) return s + l;
    }
    return s;
}

// Linear scan baked map. Returns storage offset or 0 if not found.
static unsigned lookupOffset(const char *bare) {
    for (unsigned i = 0; i < RBX_NREG; i++)
        if (strcmp(RBX_NAMES + RBX_NAMEOFF[i], bare) == 0)
            return RBX_FLAGOFF[i];
    return 0;
}

// Baked-in config: applies with no on-device file. Edit + rebuild to change.
// Device Documents/fflags.json (if present) overrides/augments these.
static NSString *const kBakedConfig =
    @"{"
    @"  \"DFIntTaskSchedulerTargetFps\": \"240\","
    @"  \"FIntFRMMinGrassDistance\": \"100\","
    @"  \"FFlagDebugSkyGray\": \"true\","
    @"  \"DFFlagDisableDPIScale\": \"true\""
    @"}";

// brsh serves the config on-device. Pulled ONCE at launch; the result replaces
// fflags.json and stays the active config until the next launch pull.
// Overridable via an "_server" key in fflags.json (e.g. the PC fflags_server).
static NSString *const kServerURL = @"http://127.0.0.1:8777/fflags.json";

static NSDictionary *unwrap(id j) {
    if (![j isKindOfClass:[NSDictionary class]]) return nil;
    return j[@"applicationSettings"] ?: j;
}

// Synchronous GET with short timeout; raw body of a 200 response, nil on any failure.
static NSData *fetchRemote(NSString *url) {
    if (!url.length) return nil;
    __block NSData *out = nil;
    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
    NSURLRequest *req = [NSURLRequest requestWithURL:[NSURL URLWithString:url]
        cachePolicy:NSURLRequestReloadIgnoringLocalCacheData timeoutInterval:2.0];
    [[[NSURLSession sharedSession] dataTaskWithRequest:req
        completionHandler:^(NSData *data, NSURLResponse *r, NSError *e) {
            if ([(NSHTTPURLResponse *)r statusCode] == 200) out = data;
            dispatch_semaphore_signal(sem);
        }] resume];
    dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3 * NSEC_PER_SEC)));
    return out;
}

// One-time launch pull from brsh. A few quick retries cover the moment brsh is
// still switching to the background. On success the body replaces fflags.json.
static void pullConfigOnce(void) {
    NSData *d = [NSData dataWithContentsOfFile:flagsPath()];
    NSDictionary *disk = d ? unwrap([NSJSONSerialization JSONObjectWithData:d options:0 error:nil]) : nil;
    NSString *url = disk[@"_server"] ?: kServerURL;

    for (int attempt = 1; attempt <= 5; attempt++) {
        NSData *body = fetchRemote(url);
        id json = body ? [NSJSONSerialization JSONObjectWithData:body options:0 error:nil] : nil;
        if (unwrap(json)) {
            [body writeToFile:flagsPath() atomically:YES];
            rbxlog(@"pulled config from %@ (attempt %d), saved as current", url, attempt);
            return;
        }
        [NSThread sleepForTimeInterval:1.0];
    }
    rbxlog(@"brsh not reachable at %@, keeping current fflags.json", url);
}

static void applyUserFlags(BOOL verbose) {
    uintptr_t base = robloxLibBase();
    if (!base) { if (verbose) rbxlog(@"RobloxLib not found, abort"); return; }

    NSMutableDictionary *flags = [NSMutableDictionary dictionary];
    // precedence: baked < fflags.json (last config pulled from brsh)
    NSDictionary *baked = unwrap([NSJSONSerialization JSONObjectWithData:
        [kBakedConfig dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil]);
    if (baked) [flags addEntriesFromDictionary:baked];
    NSData *d = [NSData dataWithContentsOfFile:flagsPath()];
    NSDictionary *disk = d ? unwrap([NSJSONSerialization JSONObjectWithData:d options:0 error:nil]) : nil;
    if (disk) [flags addEntriesFromDictionary:disk];

    if (verbose)
        rbxlog(@"apply: base=0x%lx map=%u flags=%lu", (unsigned long)base, RBX_NREG,
               (unsigned long)flags.count);

    for (NSString *key in flags) {
        if ([key hasPrefix:@"_"]) continue;              // meta (e.g. _server)
        NSString *v = [NSString stringWithFormat:@"%@", flags[key]];
        const char *bare = stripPrefix(key.UTF8String);
        unsigned off = lookupOffset(bare);
        if (!off) { if (verbose) rbxlog(@"  %@ (%s): NOT FOUND", key, bare); continue; }
        int val;
        if ([v caseInsensitiveCompare:@"true"] == NSOrderedSame)       val = 1;
        else if ([v caseInsensitiveCompare:@"false"] == NSOrderedSame) val = 0;
        else                                                            val = v.intValue;
        *(volatile int *)(base + off) = val;
        if (verbose) rbxlog(@"  set %@ -> off 0x%x = %d", key, off, val);
    }
}

__attribute__((constructor))
static void init_rbxff(void) {
    rbxlog(@"loaded. doc=%@", [logPath() stringByDeletingLastPathComponent]);
    rbxlog(@"edit flags here: %@", flagsPath());
    // Seed the user-editable file (Files app visible) with the current config.
    if (![[NSFileManager defaultManager] fileExistsAtPath:flagsPath()])
        [kBakedConfig writeToFile:flagsPath() atomically:YES encoding:NSUTF8StringEncoding error:nil];

    dispatch_queue_t q = dispatch_queue_create("rbxff.apply", DISPATCH_QUEUE_SERIAL);

    // Pull the config from brsh right away (once), while brsh is still awake.
    dispatch_async(q, ^{ pullConfigOnce(); });

    // Apply from the saved file: first pass at +10s (verbose), then re-apply
    // every 5s (quiet, no network) so the engine can't reset the values.
    static dispatch_source_t timer;
    timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, q);
    dispatch_source_set_timer(timer,
        dispatch_time(DISPATCH_TIME_NOW, (int64_t)(10 * NSEC_PER_SEC)),
        (uint64_t)(5 * NSEC_PER_SEC), (uint64_t)(1 * NSEC_PER_SEC));
    __block BOOL first = YES;
    dispatch_source_set_event_handler(timer, ^{
        applyUserFlags(first);
        first = NO;
    });
    dispatch_resume(timer);
}
